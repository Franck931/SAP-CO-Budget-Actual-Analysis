            <task id="15" uid="71333438187c4d0f865dec5c92c0d942" name="Créer les analyses par dépense et centre de coûts" meeting="false" start="2026-09-11" duration="1" complete="0" expand="true"/>
            <task id="16" uid="8b73d9f6685e437097040e99e430a7f3" name="Configurer les filtres et les interactions" meeting="false" start="2026-09-14" duration="1" complete="0" expand="true"/>
        </task>
        <task id="3" uid="ece2124fefc047dabfe655a86ae35f96" name="Sprint 4 — Tests et ajustements" color="#ff0066" meeting="false" start="2026-09-15" duration="5" complete="0" expand="true">
            <notes><![CDATA[Objectif :
Comprendre les données disponibles avant leur exploitation dans Power BI.

Travaux réalisés :
Examen des fichiers reçus, identification des tables, colonnes, dimensions et mesures financières disponibles.

Résultat obtenu :
Une première compréhension de la structure du jeu de données et de son adéquation aux besoins métier.]]></notes>
            <task id="17" uid="565eca785db04d2e9a0aa5f5ebce01bb" name="Vérifier les KPI avec les données sources" meeting="false" start="2026-09-15" duration="2" complete="0" expand="true"/>
