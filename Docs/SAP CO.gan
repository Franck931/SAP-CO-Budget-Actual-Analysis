            <task id="7" uid="46e84691ff05431c8415e66d62faffbe" name="Définir le périmètre et les KPI" meeting="false" start="2026-08-27" duration="1" complete="0" expand="true"/>
            <task id="8" uid="2d6551137306456b9aadcad9bf80b561" name="Examiner le jeu de données SAP" meeting="false" start="2026-08-28" duration="1" complete="0" expand="true"/>
            <task id="9" uid="87be0b83f032428b817d9875250babc2" name="Vérifier la qualité des données" meeting="false" start="2026-08-31" duration="1" complete="0" expand="true"/>
